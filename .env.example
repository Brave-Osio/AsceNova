# Frontend environment variables (Vite exposes only VITE_-prefixed vars to client code)
# Copy this file to .env.local and fill in real values when integrating Gemini.

# Not used directly by the client in the MVP — real Gemini calls happen
# server-side (see /server/.env.example) so the API key never reaches the browser.
VITE_API_BASE_URL=http://localhost:4000
