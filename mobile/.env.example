# Mobile environment variables (Expo exposes only EXPO_PUBLIC_-prefixed vars to app code).
# Copy this file to .env and fill in a real value.

# Same backend as the web app (server/, default port 4000).
# - iOS Simulator / Android Emulator: http://localhost:4000 usually works.
# - Expo Go on a PHYSICAL DEVICE: localhost refers to the device itself, not your
#   dev machine — use your machine's LAN IP instead, e.g. http://192.168.1.23:4000
#   (find it with `ipconfig` on Windows / `ifconfig` on Mac/Linux). Both devices
#   must be on the same Wi-Fi network.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Web OAuth client ID from Google Cloud (also listed in the server GOOGLE_CLIENT_IDS). Google button stays hidden when unset.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
