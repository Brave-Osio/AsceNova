# Copy this file to .env (local dev) and fill in real values.
# For Vercel deployment, set these same keys under Project Settings -> Environment Variables instead.

# ── Database (Supabase Postgres) ─────────────────────────────────────
# DATABASE_URL: the POOLED connection string (Transaction pooler, port 6543).
#   Used by the app at runtime — required for serverless (many short-lived
#   connections). Append `?pgbouncer=true` as shown.
# DIRECT_URL: the DIRECT connection string (port 5432).
#   Used only by `prisma migrate` — pooled connections can't run migrations
#   reliably. Both come from Supabase Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Frontend origin(s) allowed to call this API — comma-separated if more than one
# (e.g. http://localhost:5173 for local dev, https://your-app.vercel.app for prod).
CORS_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=
# Optional — e.g. "15m". Leave blank for access tokens that never expire.
JWT_ACCESS_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=12

# ── Google sign-in ────────────────────────────────────────────────────
# Comma-separated OAuth client IDs (web, and later iOS/Android) whose ID tokens the
# backend accepts. Leave blank to disable — POST /api/auth/google then returns 503.
GOOGLE_CLIENT_IDS=

# ── Email (password reset) ────────────────────────────────────────────
# Gmail SMTP. SMTP_PASS is a Google *App Password* (Google Account -> Security ->
# 2-Step Verification -> App passwords), NOT your normal password. Leave both blank to
# disable email: locally the reset token is then shown on screen; in production no
# reset email can be sent.
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "AsceNova <SMTP_USER>".
EMAIL_FROM= 
# Optional. Public frontend URL for links in emails; defaults to the first CORS_ORIGIN entry.
FRONTEND_URL=

# ── Seed data (dev/staging only — seed script no-ops if NODE_ENV=production) ──
ADMIN_SEED_EMAIL=admin@ascenova.local
ADMIN_SEED_PASSWORD=

# ── AI (Google Gemini) ────────────────────────────────────────────────
# Required for the AI Coach (/api/chat) — without it, that endpoint
# returns a 503 rather than a fake/canned reply. The rule-based plan
# generator (/api/plans) does not need this and keeps working either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Feature flags ─────────────────────────────────────────────────────
ENABLE_SIMULATE_PROGRESS=true

