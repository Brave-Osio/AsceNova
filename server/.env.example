# Copy this file to .env (local dev) and fill in real values.
# For Vercel deployment, set these same keys under Project Settings -> Environment Variables instead.

# ── Database (Supabase Postgres) ─────────────────────────────────────
# DATABASE_URL: the POOLED connection string (Transaction pooler, port 6543).
#   Used by the app at runtime — required for serverless (many short-lived
#   connections). Append `?pgbouncer=true` as shown.
# DIRECT_URL: the DIRECT connection string (port 5432).
#   Used only by `prisma migrate` — pooled connections can't run migrations
#   reliably. Both come from Supabase Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Frontend origin(s) allowed to call this API — comma-separated if more than one
# (e.g. http://localhost:5173 for local dev, https://your-app.vercel.app for prod).
CORS_ORIGIN=http://localhost:5173

# ── Auth ──────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
BCRYPT_SALT_ROUNDS=12

# ── Seed data (dev/staging only — seed script no-ops if NODE_ENV=production) ──
ADMIN_SEED_EMAIL=admin@ascenova.local
ADMIN_SEED_PASSWORD=

# ── AI (Google Gemini) ────────────────────────────────────────────────
# Optional for now — leave blank to keep using the rule-based plan/coach
# generators; the app falls back automatically when this is unset.
GEMINI_API_KEY=

# ── Feature flags ─────────────────────────────────────────────────────
ENABLE_SIMULATE_PROGRESS=true

