generator client {
  provider = "prisma-client-js"
}

// Supabase + Vercel serverless pattern: `url` is the pooled (PgBouncer,
// port 6543) connection used by the app at runtime; `directUrl` is the
// direct (port 5432) connection Prisma Migrate needs for DDL, which
// doesn't work reliably through a transaction pooler.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===================== ENUMS =====================

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum FitnessGoal {
  WEIGHT_LOSS
  MUSCLE_GAIN
  MAINTAIN_WEIGHT
}

enum FitnessLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EquipmentAccess {
  HOME
  GYM
  BOTH
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum WorkoutSplitStyle {
  PUSH_PULL_LEGS
  UPPER_LOWER
  FULL_BODY
}

enum PlanSource {
  RULE_BASED_LEGACY
  GEMINI
}

enum RankName {
  IRON
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  ASCENDANT
  IMMORTAL
  RADIANT
}

enum XpSource {
  DAILY_CHECK_IN
  WORKOUT_COMPLETED
  HIT_WATER_GOAL
  HIT_PROTEIN_GOAL
  SLEPT_7_PLUS_HOURS
  REACHED_STEP_GOAL
  SEVEN_DAY_STREAK
  THIRTY_DAY_STREAK
  ACHIEVEMENT_UNLOCK
  GOAL_PROGRESS
  CHALLENGE_COMPLETE
}

enum NotificationType {
  ACHIEVEMENT
  STREAK
  RANK_UP
  PLAN_READY
  REMINDER
  SYSTEM
  ADMIN
  CHALLENGE_INVITE
  CHALLENGE_COMPLETED
}

enum ChallengeMetric {
  WORKOUTS_COMPLETED
  WATER_GOAL_HITS
  PROTEIN_GOAL_HITS
  LOG_STREAK
}

enum ChallengeInviteStatus {
  ACTIVE
  EXPIRED
}

enum ChallengeParticipantStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum ChatRole {
  USER
  ASSISTANT
}

enum ReportFormat {
  CSV
  XLSX
}

enum ReportStatus {
  PENDING
  READY
  FAILED
}

// ===================== AUTH =====================

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  // Null for accounts created through Google sign-in until the user sets a
  // password via the forgot/reset-password flow.
  passwordHash    String?
  googleId        String?       @unique
  // `email` is the login name (shown as "Username" in the UI). This is a separate,
  // unverified Gmail address used only to deliver password-reset links.
  recoveryEmail   String?
  role            Role          @default(USER)
  status          AccountStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  deleted         Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  profile             Profile?
  workoutPlans        WorkoutPlan[]
  workoutLogs         WorkoutLog[]
  dailyProgress       DailyProgress[]
  weightProgress      WeightProgress[]
  waterLogs           WaterLog[]
  userProgress        UserProgress?
  xpHistory           XpHistory[]
  rankHistory         RankHistory[]
  achievementProgress AchievementProgress[]
  streakHistory       StreakHistory[]
  notifications       Notification[]
  leaderboardEntry    LeaderboardEntry?
  chatHistory         ChatMessage[]
  goals               Goal[]
  challengeInvitesCreated ChallengeInvite[]
  challengeParticipations ChallengeParticipant[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  reportsGenerated    Report[]              @relation("ReportsGeneratedBy")
  settingsUpdated     SystemSetting[]       @relation("SettingsUpdatedBy")

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdByIp String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ===================== PROFILE =====================

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  fullName        String
  birthday        DateTime? @db.Date
  age             Int
  gender          Gender?

  heightCm        Float
  currentWeightKg Float
  goalWeightKg    Float?

  goal                FitnessGoal
  fitnessLevel        FitnessLevel
  equipmentAccess     EquipmentAccess
  activityLevel       ActivityLevel?
  workoutFrequency    Int?
  preferredSplitStyle WorkoutSplitStyle?

  dailySchedule       Json?
  sleepHoursTarget    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ===================== WORKOUT PLAN =====================

model WorkoutPlan {
  id            String            @id @default(cuid())
  userId        String
  splitStyle    WorkoutSplitStyle
  isActive      Boolean           @default(true)
  source        PlanSource        @default(GEMINI)
  promptVersion String?
  generatedAt   DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDays   WorkoutDay[]
  nutritionPlan NutritionPlan?

  @@index([userId, isActive])
  @@index([userId, generatedAt])
  @@map("workout_plans")
}

// Calories/macros/water only — meal suggestions and BMI/BMR/TDEE depth are
// out of scope (see docs/ROADMAP.md).
model NutritionPlan {
  id            String @id @default(cuid())
  workoutPlanId String @unique

  calories     Int
  proteinGrams Int
  carbsGrams   Int
  fatGrams     Int
  sodiumMg     Int
  waterLiters  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workoutPlan WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)

  @@map("nutrition_plans")
}

model WorkoutDay {
  id                       String   @id @default(cuid())
  workoutPlanId            String
  dayIndex                 Int
  label                    String
  focus                    String
  workoutName              String?
  warmUp                   String?  @db.Text
  coolDown                 String?  @db.Text
  estimatedDurationMinutes Int?
  estimatedCaloriesBurned  Int?
  coachingTips             String[] @default([])
  progressionAdvice        String?  @db.Text

  workoutPlan WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  workoutLogs WorkoutLog[]

  @@unique([workoutPlanId, dayIndex])
  @@index([workoutPlanId])
  @@map("workout_days")
}

model WorkoutExercise {
  id                String        @id @default(cuid())
  workoutDayId      String
  order             Int
  name              String
  sets              Int
  reps              String
  restSeconds       Int
  tempo             String?
  targetMuscles     String[]      @default([])
  difficulty        FitnessLevel?
  estimatedCalories Int?
  equipment         String?
  notes             String?       @db.Text

  workoutDay WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)

  @@index([workoutDayId])
  @@map("workout_exercises")
}

// ===================== LOGS / PROGRESS =====================

model DailyProgress {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  workoutCompleted Boolean  @default(false)
  hitWaterGoal     Boolean  @default(false)
  hitProteinGoal   Boolean  @default(false)
  slept7PlusHours  Boolean  @default(false)
  reachedStepGoal  Boolean  @default(false)
  stepsCount       Int?
  sleepHours       Float?
  weightKg         Float
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_progress")
}

model WeightProgress {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  weightKg  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("weight_progress")
}

model WaterLog {
  id       String   @id @default(cuid())
  userId   String
  date     DateTime @db.Date
  amountMl Int
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("water_logs")
}

model WorkoutLog {
  id                 String   @id @default(cuid())
  userId             String
  workoutDayId       String?
  date               DateTime @db.Date
  durationMinutes    Int?
  caloriesBurned     Int?
  completedExercises Json?
  notes              String?  @db.Text
  createdAt          DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutDay WorkoutDay? @relation(fields: [workoutDayId], references: [id])

  @@index([userId, date])
  @@map("workout_logs")
}

// ===================== GAMIFICATION =====================

model UserProgress {
  id            String    @id @default(cuid())
  userId        String    @unique
  totalXp       Int       @default(0)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastLogDate   DateTime? @db.Date
  cachedRank    RankName  @default(IRON)
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model XpHistory {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  reason      XpSource
  sourceRefId String?
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, occurredAt])
  @@map("xp_history")
}

model RankHistory {
  id              String   @id @default(cuid())
  userId          String
  rank            RankName
  totalXpAtChange Int
  achievedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, achievedAt])
  @@map("rank_history")
}

model Achievement {
  id          String   @id
  title       String
  description String
  icon        String
  xpReward    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress AchievementProgress[]

  @@map("achievements")
}

model AchievementProgress {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("achievement_progress")
}

// INTENTIONALLY UNUSED (documented, not an oversight — see docs/ROADMAP.md
// Phase 14). UserProgress.currentStreak/longestStreak already carry the
// live state; nothing in this codebase currently needs a per-day audit
// trail of streak transitions. Populate only if that need arises later.
model StreakHistory {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  previousStreak   Int
  newStreak        Int
  wasReset         Boolean
  milestoneReached Int?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("streak_history")
}

// System-defined templates only — not admin-editable (see docs/ROADMAP.md
// Phase 11 scoping: admin gamification management covers Achievements only).
model Challenge {
  id          String          @id
  title       String
  description String
  icon        String
  metric      ChallengeMetric
  targetValue Int
  periodDays  Int             @default(7)
  xpReward    Int             @default(100)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  invites ChallengeInvite[]

  @@map("challenges")
}

// One specific time-boxed run of a Challenge, started by a user (who is
// also its first, auto-accepted participant) and optionally shared with
// friends by email invite.
model ChallengeInvite {
  id              String                 @id @default(cuid())
  challengeId     String
  createdByUserId String
  periodStart     DateTime               @default(now())
  periodEnd       DateTime
  status          ChallengeInviteStatus  @default(ACTIVE)
  createdAt       DateTime               @default(now())

  challenge   Challenge             @relation(fields: [challengeId], references: [id])
  createdBy   User                  @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  participants ChallengeParticipant[]

  @@index([createdByUserId])
  @@index([status, periodEnd])
  @@map("challenge_invites")
}

model ChallengeParticipant {
  id                String                     @id @default(cuid())
  challengeInviteId String
  userId            String
  status            ChallengeParticipantStatus @default(INVITED)
  progressValue     Int                        @default(0)
  completedAt       DateTime?
  createdAt         DateTime                   @default(now())

  challengeInvite ChallengeInvite @relation(fields: [challengeInviteId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeInviteId, userId])
  @@index([userId])
  @@map("challenge_participants")
}

// INTENTIONALLY UNUSED (documented, not an oversight — see docs/ROADMAP.md
// Phase 14). The leaderboard is computed live from UserProgress on every
// request (leaderboardService.ts) instead of precomputed into this table
// — this codebase has no scheduler/cron (Vercel serverless deploy target)
// to ever keep a materialized copy fresh, and live queries have been fast
// enough at the current scale. Revisit if that changes.
model LeaderboardEntry {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String
  rank          RankName
  totalXp       Int
  currentStreak Int
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXp(sort: Desc)])
  @@map("leaderboard_entries")
}

// ===================== CHAT / GOALS / NOTIFICATIONS =====================

model ChatMessage {
  id              String   @id @default(cuid())
  userId          String
  role            ChatRole
  message         String   @db.Text
  contextSnapshot Json?
  promptVersion   String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}

model Goal {
  id           String      @id @default(cuid())
  userId       String
  goalType     FitnessGoal
  targetValue  Float?
  targetDate   DateTime?   @db.Date
  status       GoalStatus  @default(ACTIVE)
  progressNote String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  completedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("goals")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ===================== ADMIN =====================

// INTENTIONALLY UNUSED (documented, not an oversight — see docs/ROADMAP.md
// Phase 14). Admin analytics (server/src/services/adminService.ts's
// getStats()) are computed live via Prisma aggregate queries on every
// request instead of precomputed into daily snapshots — same "no
// scheduler, live queries are fast enough" reasoning as LeaderboardEntry.
model AdminAnalyticsSnapshot {
  id                  String             @id @default(cuid())
  snapshotDate        DateTime           @unique @db.Date
  totalUsers          Int
  newUsers            Int
  activeUsers         Int
  inactiveUsers       Int
  retentionRate7d     Float
  retentionRate30d    Float
  avgCompletionRate   Float
  popularGoal         FitnessGoal?
  popularSplitStyle   WorkoutSplitStyle?
  createdAt           DateTime           @default(now())

  @@map("admin_analytics_snapshots")
}

// INTENTIONALLY UNUSED (documented, not an oversight — see docs/ROADMAP.md
// Phase 14). No admin reporting/export-generation feature has been built
// yet beyond the CSV user export in adminService.ts, which doesn't need
// an async job record — this model anticipates a future async report
// pipeline (e.g. a large export queued and polled for), not built yet.
model Report {
  id                String       @id @default(cuid())
  generatedByUserId String
  type              String
  format            ReportFormat
  filters           Json
  status            ReportStatus @default(PENDING)
  fileUrl           String?
  createdAt         DateTime     @default(now())

  generatedBy User @relation("ReportsGeneratedBy", fields: [generatedByUserId], references: [id])

  @@index([generatedByUserId, createdAt])
  @@map("reports")
}

// INTENTIONALLY UNUSED (documented, not an oversight — see docs/ROADMAP.md
// Phase 14). Anticipates a future admin-configurable settings feature
// (feature flags, app-wide toggles, etc.) — nothing in this codebase
// currently needs runtime-configurable settings; everything is either an
// env var (deploy-time config) or per-user data.
model SystemSetting {
  id              String   @id @default(cuid())
  key             String   @unique
  value           Json
  description     String?
  updatedByUserId String?
  updatedAt       DateTime @updatedAt

  updatedBy User? @relation("SettingsUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("system_settings")
}
